# Virtualenv / caches
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Celery beat local state (regenerated by the beat container)
celerybeat-schedule
celerybeat-schedule*

# Secrets — never bake into the image; mounted at runtime instead
.env
.env.*
firebase-service-account.json
cloudfront-private-key.pem

# Tests and tooling not needed in the runtime image
tests/
*.md
