# MuskMaker backend configuration. Copy to `.env` and fill in real values.
# Keys map 1:1 to app/config.py Settings (pydantic-settings, case-insensitive).

# ── App ───────────────────────────────────────────────────────────────────────
app_name=MuskMaker API
app_env=production            # development | staging | production
debug=false                  # keep false in prod (disables /docs and /redoc)

# ── Database ──────────────────────────────────────────────────────────────────
# In Docker, the host is the compose service name `db`, NOT localhost.
# User/password/db must match POSTGRES_* in docker-compose.yml.
database_url=postgresql+asyncpg://postgres:muskmaker@db:5432/muskmaker

# ── Firebase Auth ─────────────────────────────────────────────────────────────
firebase_project_id=your-firebase-project-id
firebase_service_account_path=firebase-service-account.json

# ── AWS / S3 / CloudFront ─────────────────────────────────────────────────────
aws_region=us-east-1
aws_access_key_id=your-access-key
aws_secret_access_key=your-secret-key
s3_bucket_photos=muskmaker-photos-prod
s3_bucket_assets=muskmaker-assets-prod
cloudfront_domain=d1234abcd.cloudfront.net
cloudfront_key_pair_id=your-key-pair-id
cloudfront_private_key_path=cloudfront-private-key.pem
s3_upload_url_expiry=300
s3_download_url_expiry=3600

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Same string goes in the RevenueCat webhook Authorization header.
revenuecat_webhook_secret=choose-a-long-random-string

# ── OpenAI (AI verification) ──────────────────────────────────────────────────
openai_api_key=sk-...
openai_model=gpt-4o
ai_confidence_threshold=0.75

# ── Serper Maps (location verification) ───────────────────────────────────────
serper_api_key=your-serper-key

# ── Expo Push ─────────────────────────────────────────────────────────────────
expo_push_url=https://exp.host/--/api/v2/push/send

# ── Celery / RabbitMQ ─────────────────────────────────────────────────────────
# In Docker, the host is the compose service name `rabbitmq`, NOT localhost.
rabbitmq_url=amqp://guest:guest@rabbitmq:5672//

# ── Rate limits / anti-cheat / sweepstakes (optional overrides) ───────────────
timezone_change_rate_limit=1
verification_rate_limit=10
exif_delta_warn_seconds=300
exif_delta_fail_seconds=600
exif_delta_premium_warn_seconds=120
goal_reminder_minutes_before_expiry=60
sweep_winner_claim_days=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array. Restrict to real origins in production instead of ["*"].
cors_origins=["*"]
